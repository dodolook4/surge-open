name: local-group
desc: 区域策略分组

proxy-groups:

- include-all: true
  filter: 'JP'
  name: local-jp
  type: select

- include-all: true
  filter: 'HK'
  name: local-hk
  type: select

- include-all: true
  filter: 'US'
  name: local-us
  type: select

- include-all: true
  filter: 'KR'
  name: local-kr
  type: select

- include-all: true
  filter: 'TW'
  name: local-tw
  type: select

rule-providers:
  Netflix:
    type: http
    behavior: classical
    url: "https://githubusercontent.com"
    path: ./ruleset/netflix.list
    interval: 86400

rules:
  - RULE-SET,Netflix,local-tw
