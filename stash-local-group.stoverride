name: local-group
desc: 区域策略分组

proxy-groups:
- name: "香港节点"
    type: url-test
    url: http://gstatic.com
    interval: 300
    use:
      - UPear
    filter: 'HK'
- include-all: true
  filter: 'JP'
  name: local-jp
  type: select

- include-all: true
  filter: 'HK'
  name: local-hk
  type: select

- include-all: true
  filter: 'US'
  name: local-us
  type: select

- include-all: true
  filter: 'KR'
  name: local-kr
  type: select

- include-all: true
  filter: 'TW'
  name: local-tw
  type: select
